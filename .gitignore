# LibreLane run outputs and saved views (huge; must NOT be copied into the nix
# store by `nix develop`, or every invocation copies gigabytes and hangs).
**/runs/
librelane/padframe/runs/
librelane/wrapper/runs/
runs/
build/
signoff/
precheck_results/
*.log

# Python
__pycache__/
*.pyc

# Nix
result
result-*

# Stored gzipped (over the 50 MB advisory limit of GitHub); make uncompress, or
# any target that reads it, expands it.
/gds/double_wide_chip_io.gds
